generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String             @id @default(cuid())
  email        String             @unique
  passwordHash String
  name         String
  avatarColor  String             @default("#EF4444")
  createdAt    DateTime           @default(now())
  createdTrips Trip[]             @relation("TripCreator")
  collabs      TripCollaborator[]
  addedPlaces  TripPlace[]
  addedHotels  TripHotel[]
}

model Trip {
  id              String             @id @default(cuid())
  title           String
  destination     String
  destinationLat  Float?
  destinationLng  Float?
  startDate       DateTime
  endDate         DateTime
  travelStyle     String             @default("cost-saving")
  travelerCount   Int                @default(1)
  status          String             @default("planning")
  completedAt     DateTime?
  askedCompletion Boolean            @default(false)
  creatorId       String
  creator         User               @relation("TripCreator", fields: [creatorId], references: [id])
  collaborators   TripCollaborator[]
  places          TripPlace[]
  hotels          TripHotel[]
  extraActivities ExtraActivity[]
  disruptions     Disruption[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model TripCollaborator {
  id       String   @id @default(cuid())
  tripId   String
  trip     Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  role     String   @default("editor")
  joinedAt DateTime @default(now())

  @@unique([tripId, userId])
}

model Place {
  id            String      @id @default(cuid())
  destination   String
  name          String
  neighborhood  String?
  category      String?
  rating        Float       @default(4.5)
  durationLabel String      @default("1-2 hrs")
  lat           Float
  lng           Float
  imageUrl      String?
  isHiddenGem   Boolean     @default(false)
  tripPlaces    TripPlace[]
  reviews       Review[]
}

model Hotel {
  id            String @id @default(cuid())
  destination   String
  name          String
  neighborhood  String?
  rating        Float  @default(4.3)
  pricePerNight Int
  tier          String // "budget" | "mid" | "luxury"
  lat           Float
  lng           Float
  imageUrl      String?
  tripHotels    TripHotel[]
}

model TripHotel {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  addedById String?
  addedBy   User?    @relation(fields: [addedById], references: [id])
  createdAt DateTime @default(now())

  @@unique([tripId, hotelId])
}

model TripPlace {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  placeId   String
  place     Place    @relation(fields: [placeId], references: [id])
  day       Int      @default(1)
  order     Int      @default(0)
  visited   Boolean  @default(true)
  addedById String?
  addedBy   User?    @relation(fields: [addedById], references: [id])
  createdAt DateTime @default(now())

  @@unique([tripId, placeId])
}

model ExtraActivity {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime @default(now())
}

model Review {
  id            String   @id @default(cuid())
  placeId       String
  place         Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  reviewerName  String
  rating        Float
  verified      Boolean  @default(true)
  tripType      String // "Solo" | "Couple" | "Family" | "Friends"
  visitedMonth  String // e.g. "Aug 2026"
  text          String
  helpfulCount  Int      @default(0)
  createdAt     DateTime @default(now())
}

model LocalIntel {
  id          String @id @default(cuid())
  destination String
  category    String // "weather" | "money" | "transport" | "custom" | "safety" | "connectivity"
  title       String
  tip         String
}

model Disruption {
  id            String             @id @default(cuid())
  tripId        String
  trip          Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  scenarioType  String // "flight_delay" | "hotel_overbooked" | "car_unavailable"
  label         String
  summary       String
  status        String             @default("proposed") // "proposed" | "applied" | "dismissed"
  createdAt     DateTime           @default(now())
  actions       DisruptionAction[]
}

model DisruptionAction {
  id           String     @id @default(cuid())
  disruptionId String
  disruption   Disruption @relation(fields: [disruptionId], references: [id], onDelete: Cascade)
  icon         String
  title        String
  detail       String
  outcome      String // "auto-resolved" | "needs-confirmation" | "at-risk"
  status       String     @default("proposed") // "proposed" | "applied"
  order        Int        @default(0)
}
